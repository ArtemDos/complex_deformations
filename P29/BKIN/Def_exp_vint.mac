!!! Программа задания  деформаций функциями, соответствующими винтовой траектории деформаций
!!! Для упруго-пласт. плоско-напряж. элемента
!!! Размерность мм, МПа

/FILENAME, P29_BKIN_Incompressible
/CLEAR,NOSTART

size=1 !! Размер элемента в мм
pi=acos(-1)

epsy00=0.005 !!! В экспернименте это величина epsz*=0.005, одинаковая для всех экспериментов
cc=25e-4 !!! Для эксперимента П.29
a=157e-4 !!! Для эксперимента шаг винтовой линии
epsy0=epsy00+cc !!! Величина деформации растяжения по y


/PREP7
ET,1,PLANE182
MP,EX,1,2.05e5 !!! МПа
MP,PRXY,1,0.29
TB,BKIN,1,1,2
TBTEMP,0
TBDATA,,360,10000,,,, !!!МПа !!! Сталь 45

! узлы элемента
N,1,0,0,0
N,2,size,0,0
N,3,size,size,0
N,4,0,size,0
E,1,2,3,4


/SOLU
!!!!!!! 1-ый шаг - решение с нулевыми граничными условиями
D,ALL,ALL,0
SOLVE !!! Нулевая точка
OUTRES,ALL,ALL

!!!!!!!!!!!! 1-ый этап - одноосное деформирование по у до величины epsy0

N_stage1 = 20 !!! шагов расчета
d0=epsy0/N_stage1  !!! Прирост деформации на каждом шаге


! Жестко закрепляем узел 1
D,1,UX,0 
D,1,UY,0

*DO,i,1,N_stage1 ,1

	! Целевые деформации на текущем шаге i
	epsx = 0
	epsy = d0*i
	tauxy = 0

	! Вычисляем ВСЕ компоненты перемещений по формулам (3.4)
	! ux = epsx*x + tauxy*y
	! uy = epsy*y
    
	! Узел 2 (x=size, y=0)
	d2x = epsx*size + tauxy*0
	d2y = epsy*0
    
	! Узел 3 (x=size, y=size)
	d3x = epsx*size + tauxy*size
	d3y = epsy*size
    
	! Узел 4 (x=0, y=size)
	d4x = epsx*0 + tauxy*size
	d4y = epsy*size

	! Прикладываем ВСЕ вычисленные перемещения ко ВСЕМ свободным узлам
	D,2,UX,d2x
	D,2,UY,d2y
	
	D,3,UX,d3x
	D,3,UY,d3y
	
	D,4,UX,d4x
	D,4,UY,d4y
	
	TIME,i+1
	NSUBST,100,0,0
	AUTOTS,1
	SOLVE
*ENDDO

!!!!!!! 2-ой этап - деформирование по винтовой линии

nv = 1.75 !!! Количество витков
N_stage2 = 200 !!! Шагов расчета на втором этапе
dalf = (2*pi*nv) / N_stage2 ! Изменение угла на каждом шаге

*DO,j,1,N_stage2,1

	alf=dalf*j
	epsx = sqrt(3)/2*a*(alf/(2*pi)) - 1/2*cc*(cos(alf)-1) !!! соответствует eps_tetta
	epsy=cc*(cos(alf)-1)+epsy0 !!! соответствует eps_z
	tauxy=2*sqrt(3)/2*cc*sin(alf) !!! соответствует gamma_tetta_z=2*eps_tetta_z

	! Узел 2 (x=size, y=0)
	d2x = epsx*size + tauxy*0
	d2y = epsy*0
    
	! Узел 3 (x=size, y=size)
	d3x = epsx*size + tauxy*size
	d3y = epsy*size
    
	! Узел 4 (x=0, y=size)
	d4x = epsx*0 + tauxy*size
	d4y = epsy*size

	D,2,UX,d2x
	D,2,UY,d2y
	
	D,3,UX,d3x
	D,3,UY,d3y
	
	D,4,UX,d4x
	D,4,UY,d4y

	TIME,j+N_stage1+1
	NSUBST,100,0,0
	AUTOTS,1 !Включить автомат. шаг расчета

	SOLVE
*ENDDO

FINISH


/POST26

*GET, ActiveJob, ACTIVE, 0, JOBNAM
FILE, ActiveJob, 'rst'

NUMVAR, 20

! --- Объявление деформаций
ESOL,2,1,3,EPEL,X,
ESOL,3,1,3,EPPL,X,
ADD,4,2,3, , , , ,1,1,1, !!! полная деформация eps_xx

ESOL,5,1,3,EPEL,Y,
ESOL,6,1,3,EPPL,Y,
ADD,7,5,6, , , , ,1,1,1, !!! полная деформация eps_yy

ESOL,8,1,3,EPEL,XY,
ESOL,9,1,3,EPPL,XY,
ADD,10,8,9, , , , ,1,1,1, !!! полная деформация eps_xy (инженерная)
ADD,10,10, , ,eps_xy, , ,1/2,1,1, !!! полная деформация eps_xy

ESOL,11,1,3,EPEL,Z,
ESOL,12,1,3,EPPL,Z,
ADD,13,11,12, , , , ,1,1,1, !!! полная деформация eps_zz

! --- Объявление напряжений
ESOL,14,1,3,S,X,
ESOL,15,1,3,S,Y,
ESOL,16,1,3,S,XY,
ESOL,17,1,3,S,EQV, ! интенсивность напряжений

XVAR,1 ! строим графики от времени

PLVAR,4,7,10,13, , , , , , , !!! график деформаций

ESOL,18,1,3,EPPL,EQV, ! интенсивность деформаций
ESOL,19,1,3,NL,EPEQ, ! параметр Одквиста

! Загружаем все объявленные переменные данными
STORE,MERGE

! --- Копирование ВСЕХ данных из POST26 в массивы APDL ---
*GET, NumSteps, VARI, 1, NSETS

! Создаем массивы для ВСЕХ переменных (с 1 по 19)
*DIM, var1_time, ARRAY, NumSteps
*DIM, var2_epelx, ARRAY, NumSteps
*DIM, var3_epplx, ARRAY, NumSteps
*DIM, var4_eptox, ARRAY, NumSteps
*DIM, var5_epely, ARRAY, NumSteps
*DIM, var6_epply, ARRAY, NumSteps
*DIM, var7_eptoy, ARRAY, NumSteps
*DIM, var8_epelxy, ARRAY, NumSteps
*DIM, var9_epplxy, ARRAY, NumSteps
*DIM, var10_eptoxy, ARRAY, NumSteps
*DIM, var11_epelz, ARRAY, NumSteps
*DIM, var12_epplz, ARRAY, NumSteps
*DIM, var13_eptoz, ARRAY, NumSteps
*DIM, var14_sx, ARRAY, NumSteps
*DIM, var15_sy, ARRAY, NumSteps
*DIM, var16_sxy, ARRAY, NumSteps
*DIM, var17_seqv, ARRAY, NumSteps
*DIM, var18_eppleqv, ARRAY, NumSteps
*DIM, var19_nlepeq, ARRAY, NumSteps

! Заполняем массивы данными из переменных POST26
VGET, var1_time(1), 1
VGET, var2_epelx(1), 2
VGET, var3_epplx(1), 3
VGET, var4_eptox(1), 4
VGET, var5_epely(1), 5
VGET, var6_epply(1), 6
VGET, var7_eptoy(1), 7
VGET, var8_epelxy(1), 8
VGET, var9_epplxy(1), 9
VGET, var10_eptoxy(1), 10
VGET, var11_epelz(1), 11
VGET, var12_epplz(1), 12
VGET, var13_eptoz(1), 13
VGET, var14_sx(1), 14
VGET, var15_sy(1), 15
VGET, var16_sxy(1), 16
VGET, var17_seqv(1), 17
VGET, var18_eppleqv(1), 18
VGET, var19_nlepeq(1), 19

! --- Выгрузка массивов в CSV файл ---
*CFOPEN, %ActiveJob%, csv

! Записываем заголовок
*VWRITE,'Time','EPEL_X','EPPL_X','EPTO_X','EPEL_Y','EPPL_Y','EPTO_Y','EPEL_XY_eng','EPPL_XY_eng','EPTO_XY_tensor','EPEL_Z','EPPL_Z','EPTO_Z','S_X','S_Y','S_XY','S_EQV','EPPL_EQV','NL_EPEQ'
(A,',',A,',',A,',',A,',',A,',',A,',',A,',',A,',',A,',',A,',',A,',',A,',',A,',',A,',',A,',',A,',',A,',',A,',',A)

! Записываем данные в цикле
*DO, i, 1, NumSteps, 1
    *VWRITE, var1_time(i), var2_epelx(i), var3_epplx(i), var4_eptox(i), var5_epely(i), var6_epply(i), var7_eptoy(i), var8_epelxy(i), var9_epplxy(i), var10_eptoxy(i), var11_epelz(i), var12_epplz(i), var13_eptoz(i), var14_sx(i), var15_sy(i), var16_sxy(i), var17_seqv(i), var18_eppleqv(i), var19_nlepeq(i)
    (E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7,',',E14.7)
*ENDDO

*CFCLOS

FINISH
